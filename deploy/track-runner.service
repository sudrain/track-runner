[Unit]
Description=Track Runner API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=trackrunner
Group=trackrunner
WorkingDirectory=/opt/track-runner
EnvironmentFile=/opt/track-runner/.env
ExecStart=/opt/track-runner/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
