# PostgreSQL (установится автоматически при деплое)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Секретный ключ JWT — заменится на случайный при деплое
SECRET_KEY=change-me-in-production
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# По IP без HTTPS: COOKIE_SECURE=false
# С доменом и HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false

# За reverse proxy (nginx) — true, иначе rate limit будет брать 127.0.0.1
TRUSTED_PROXY=true

# Пробел разделитель для нескольких origins
CORS_ORIGINS=http://localhost:5173,http://<IP-АДРЕС-ВАШЕЙ-VPS>
DB_ECHO=false
