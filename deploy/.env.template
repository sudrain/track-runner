# PostgreSQL (установится автоматически при деплое)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Секретный ключ JWT — заменится на случайный при деплое
SECRET_KEY=change-me-in-production
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO

# По IP без HTTPS: COOKIE_SECURE=false
# С доменом и HTTPS: COOKIE_SECURE=true
COOKIE_SECURE=false

# За reverse proxy (nginx) — true, иначе rate limit будет брать 127.0.0.1
TRUSTED_PROXY=true

# false — миграции запускаются вручную: alembic upgrade head
AUTO_MIGRATE=false

# Несколько origins через запятую
CORS_ORIGINS=http://<IP-АДРЕС-ВАШЕЙ-VPS>
DB_ECHO=false
