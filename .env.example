# База данных (можно SQLite для начала)
DATABASE_URL=sqlite+aiosqlite:///./workout.db
# Секретный ключ для JWT (сгенерируй любой длинной строкой)
SECRET_KEY=super-secret-key-change-me-in-production
# Алгоритм JWT
ALGORITHM=HS256
# Время жизни токенов в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7