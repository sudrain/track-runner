# SQLite для разработки (не требует PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Для продакшена — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Секретный ключ для JWT (сгенерируй любой длинной строкой)
SECRET_KEY=change-me-in-production

# Алгоритм JWT
ALGORITHM=HS256

# Время жизни токенов
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Автомиграция при старте (true — для разработки, false — для продакшена)
# В продакшене запускайте миграции вручную: alembic upgrade head
# AUTO_MIGRATE=false

# Безопасность (продакшен)
# COOKIE_SECURE=true
# TRUSTED_PROXY=true
